# Portal — set di Vercel Environment Variables (project terpisah, root: portal/)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_LANDING_URL=https://www.harunokaze.id
# OPENROUTER_API_KEY is configured in Supabase Edge Function Secrets, never as a VITE_ variable.
# Optional Edge Function secrets: OPENROUTER_MODEL, OPENROUTER_SITE_URL, OPENROUTER_APP_TITLE.
