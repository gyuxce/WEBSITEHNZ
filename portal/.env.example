# Portal — Neon + Better Auth + Midtrans
# Copy ke portal/.env (local) dan set di Vercel Environment Variables

# Neon Postgres connection string (pooled OK)
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth (min 32 chars)
BETTER_AUTH_SECRET=replace-with-long-random-secret-at-least-32
# Public URL of the portal (local or production)
BETTER_AUTH_URL=http://localhost:5174
VITE_APP_URL=http://localhost:5174

# Optional: email reset password (tanpa ini, link di-log di server)
# RESEND_API_KEY=
# RESEND_FROM=Harunokaze <noreply@harunokaze.id>

# Midtrans
VITE_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# ALLOW_SANDBOX_PAY=true

VITE_PEMETAAN_PRICE=150000
VITE_LANDING_URL=https://www.harunokaze.id

# API port (local only)
API_PORT=8787
